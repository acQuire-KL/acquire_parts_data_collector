            "Name": "Transient Voltage Suppressors (TVS)",
            "ProductCount": 0,
            "NewProductCount": 0,
            "ImageUrl": "https://www.digikey.ie//mm.digikey.com/Volume0/opasdata/d220001/derivates/3/002/256/835/DO-214AA_SMB_tmb%2864x64%29.jpg",
            "SeoDescription": "TVS, or Transient Voltage Suppressors are devices designed to limit or prevent temporary surges or spikes within a specific voltage level.",
            "ChildCategories": [
              {
                "CategoryId": 144,
                "ParentId": 2040,
                "Name": "TVS Diodes",
                "ProductCount": 0,
                "NewProductCount": 0,
